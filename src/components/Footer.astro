---
const whatsappUrl = "https://wa.me/529842672899?text=" + encodeURIComponent("Hola, deseo más información sobre el Colegio Inglés.");
---

<footer class="bg-colegio-navy text-white pt-10 pb-6 px-4">
  <div class="max-w-6xl mx-auto">
    
    <!-- Fila Principal: Datos + Botón WhatsApp -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-8 border-b border-white/10 text-center md:text-left">
      
      <!-- Columna Datos de Contacto -->
      <div class="space-y-3">
        <h4 class="text-xl font-black text-colegio-cyan">Contáctanos</h4>
        
        <!-- Teléfonos -->
        <div class="flex items-center justify-center md:justify-start gap-2 text-sm text-slate-200">
          <svg class="w-4 h-4 fill-current text-colegio-cyan" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/></svg>
          <a href="tel:9842672899" class="hover:text-white transition">(984) 267 2899</a>
          <span>|</span>
          <a href="tel:9842672999" class="hover:text-white transition">(984) 267 2999</a>
        </div>

        <!-- Dirección -->
        <div class="flex items-start justify-center md:justify-start gap-2 text-xs md:text-sm text-slate-300 max-w-md">
          <svg class="w-4 h-4 fill-current text-colegio-cyan shrink-0 mt-0.5" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
          <span>Calle 72 entre Av. Sian Ka'an y Carr. Federal Maza 026 Col. Ejidal, Playa del Carmen Q. Roo.</span>
        </div>
      </div>

      <!-- Botón WhatsApp Destacado -->
      <div>
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-3 bg-colegio-green hover:brightness-110 transition-all text-white font-bold px-7 py-3 rounded-full shadow-lg hover:-translate-y-0.5"
        >
          <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <div class="text-left leading-tight">
            <span class="text-xs block font-normal opacity-90">Escríbenos en</span>
            <span class="text-lg font-bold">WhatsApp</span>
          </div>
        </a>
      </div>

    </div>

    <!-- Enlace Aviso de Privacidad -->
    <div class="pt-6 text-center">
      <a href="https://colegioinglesplaya.com/avisoPrivacidad" class="text-colegio-cyan hover:underline text-xs md:text-sm font-medium">
        Aviso de privacidad
      </a>
    </div>

  </div>
</footer>